{
  "name": "flashcast",
  "version": "0.2.3",
  "description": "A fast, keyboard-first, Raycast-like launcher for Linux, macOS and Windows.",
  "main": "out/main/index.js",
  "author": "Flashcast",
  "license": "MIT",
  "private": true,
  "desktopName": "com.flashcast.app.desktop",
  "devDesktopName": "com.flashcast.app.dev.desktop",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "node scripts/ensure-dev-desktop-entry.mjs && electron-vite dev --noSandbox",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview:ui": "vite --config vite.preview.config.ts",
    "dist": "pnpm build && electron-builder",
    "dist:linux": "pnpm build && electron-builder --linux",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:win": "pnpm build && electron-builder --win",
    "icons": "node scripts/generate-icons.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "lucide-react": "1.65.0",
    "pinyin-pro": "3.29.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
